{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"types": ["node"]
	},
	"include": ["index.ts", "types.ts", "src/**/*.ts", "test/**/*.ts", "types/**/*.d.ts"]
}
